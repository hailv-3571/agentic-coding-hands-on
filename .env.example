# Copy to .env.local and fill in. Never commit real values.
# Local stack: `npx supabase start`, then `npx supabase status -o env` prints the values
# (DB_URL, API_URL, ANON_KEY, SERVICE_ROLE_KEY).
# All variables are validated at boot by shared/config/env-schema.ts; the app refuses to
# start with a readable error when one is missing or invalid.
# CI typecheck jobs without secrets: `npm run typecheck` already sets SKIP_ENV_VALIDATION=1
# for itself. Never set it for dev/build/start (it skips the boot check in next.config.ts).

# --- Supabase / database (server-only unless prefixed NEXT_PUBLIC_) ---
# Hosted: use the pooler URL (port 6543, transaction mode) with ?sslmode=require.
DATABASE_URL=postgresql://postgres:<db-password>@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Hosted Supabase: disable public Realtime channels in the dashboard (Realtime settings);
# the app only uses private Broadcast channels.

# --- Event milestones: ISO-8601 WITH offset. Required: LAUNCH_AT < EVENT_END_AT <= NATIONAL_KUDOS_FINALIZE_AT
LAUNCH_AT=2026-11-01T00:00:00+07:00
EVENT_AT=2026-12-26T18:00:00+07:00
EVENT_END_AT=2026-12-31T23:59:59+07:00
NATIONAL_KUDOS_FINALIZE_AT=2027-01-01T00:00:00+07:00

# --- Access ---
# Comma-separated; these accounts are Admin on every sign-in (cannot be demoted in the UI).
ADMIN_EMAILS=<admin@sun-asterisk.com>
# Optional (default sun-asterisk.com)
ALLOWED_EMAIL_DOMAIN=sun-asterisk.com

# --- Internal self-fetch (optional) ---
# Origin (scheme://host:port, no path) at which the server reaches ITSELF: the session proxy
# fetches /access-denied from here to answer a non-admin's /admin/* with HTTP 403. Never taken
# from the request's Host header (SSRF). Leave empty for http://127.0.0.1:$PORT (PORT is set by
# `next start` / `next dev`, default 3000). Set it when the server binds elsewhere, e.g. `-H ::1`.
INTERNAL_APP_ORIGIN=

# --- Internal job endpoint (optional) ---
# Shared secret of POST /api/internal/secret-box/tick (Secret Box sweep + Kudos Quốc Dân finalize),
# sent as the `x-job-secret` header by pg_cron (stored in Supabase Vault as `saa_internal_job_secret`,
# see db/migrations/0016_secret_box_tick_cron.sql) or by a host cron (curl every minute). At least
# 32 characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Leave empty to disable the endpoint (it answers 503); boxes are still granted on every page visit.
INTERNAL_JOB_SECRET=

# Phase 13 notifications: shared secret of POST /api/internal/notifications/drain, sent as the
# `x-drain-secret` header by pg_cron every 5 s (stored in Supabase Vault as `saa_outbox_drain_secret`
# next to the URL `saa_notifications_drain_url`, see db/migrations/0020_notifications_drain_cron.sql)
# or by a host cron. At least 32 characters, generated like INTERNAL_JOB_SECRET. Leave empty to
# disable the endpoint (it answers 503): outbox events then wait, unconsumed, and no notification is made.
OUTBOX_DRAIN_SECRET=

# --- Google sign-in for the LOCAL Supabase stack (not read by the app) ---
# Put these two in supabase/.env (git-ignored): the Supabase CLI substitutes them into
# supabase/config.toml [auth.external.google] on `npx supabase start`. Google Cloud console:
# OAuth client "Web application", redirect URI http://127.0.0.1:54321/auth/v1/callback.
# Hosted projects configure Google (and the before_user_created hook) in the dashboard.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<google-oauth-client-id>
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<google-oauth-client-secret>

# --- Game rules (optional; defaults shown) ---
HEART_CAMPAIGN_MULTIPLIER=2
SECRET_BOX_HEARTS_PER_BOX=5

# --- Admin (optional; defaults shown) ---
ADMIN_TIMEZONE=Asia/Ho_Chi_Minh
EXPORT_MAX_ROWS=10000
